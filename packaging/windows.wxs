<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- UpgradeCode stays fixed so a newer MSI replaces this install.
       Per-user. MUNINN_HOME\code\plugins when that variable is set for the
       account running the installer, otherwise %USERPROFILE%\.muninn\code\plugins. -->
  <Package
      Name="Muninn Coinbase Connector"
      Manufacturer="Weird Brains LLC"
      Version="$(var.Version)"
      UpgradeCode="7C4E9A2B-1D6F-4A83-9E25-B8C0D3F14A67"
      Language="1033"
      Scope="perUser"
      InstallerVersion="500"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Muninn Coinbase Connector is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <SetProperty Id="MUNINN_HOME_VALUE" Value="[%MUNINN_HOME]" Sequence="both" Before="SetInstallFromHome" />
    <SetProperty Id="INSTALLFOLDER" Action="SetInstallFromHome" Value="[MUNINN_HOME_VALUE]\code\plugins" Sequence="both" Before="CostFinalize" Condition="MUNINN_HOME_VALUE" />
    <SetProperty Id="INSTALLFOLDER" Action="SetInstallFromDefault" Value="[%USERPROFILE]\.muninn\code\plugins" Sequence="both" After="SetInstallFromHome" Condition="NOT MUNINN_HOME_VALUE" />

    <Feature Id="Main">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="INSTALLFOLDER" Name="plugins" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="PluginDll" Guid="B1E4C8A2-6F0D-4C55-9A31-2D7E5B9C0F18">
        <CreateFolder />
        <File Id="PluginDllFile" Source="$(var.Payload)/muninn_coinbase_connector.dll" KeyPath="yes" />
      </Component>
      <Component Id="LicenseFile" Guid="C2F5D9B3-701E-4D66-8B42-3E8F6CAD1029">
        <File Id="LicenseFileFile" Source="$(var.Payload)/LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="ReadmeFile" Guid="D306EAC4-812F-4E77-9C53-4F907DBE213A">
        <File Id="ReadmeFileFile" Source="$(var.Payload)/README.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
